DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-me
PORT=3030

# Local LLM (primary AI provider)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# Vision extraction (question-bank PDF extraction pipeline)
OPENROUTER_API_KEY=

# Branding — see src/config/branding.ts. Every var below is optional; the app falls
# back to Brainwave's current values if unset, so leaving all of these blank is safe.
# INSTITUTE_NAME=Brainwave Science Academy
# INSTITUTE_SHORT_NAME=BSA
# INSTITUTE_TAGLINE=Excellence in Education • Performance Analysis Portal

# Report-card PDF generation: absolute base URL puppeteer uses to fetch the logo image
# in production (falls back to reading frontend/public/logo.jpeg directly in local dev).
# FRONTEND_URL=https://your-deployment-domain.example
